{
  "name": "persian-digital-human",
  "version": "0.1.0",
  "private": true,
  "description": "دستیار دیجیتال فارسی — انسان دیجیتال با چهره، صدا و دانش اختصاصی",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:prune": "tsx scripts/prune-data.ts",
    "verify:core": "tsx scripts/verify-core.ts",
    "verify": "npm run lint && npm run typecheck && npm run verify:core && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "jose": "6.2.8",
    "livekit-server-sdk": "2.17.0",
    "mammoth": "1.12.1",
    "next": "15.5.23",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "server-only": "0.0.1",
    "unpdf": "1.8.0",
    "zod": "3.25.76",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.26",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
