{
  "name": "persian-digital-human",
  "version": "0.1.0",
  "private": true,
  "description": "دستیار دیجیتال فارسی — انسان دیجیتال با چهره، صدا و دانش اختصاصی",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "node scripts/seed-demo-media.mjs",
    "db:prune": "tsx scripts/prune-data.ts",
    "verify:core": "tsx scripts/verify-core.ts",
    "verify": "npm run lint && npm run typecheck && npm run verify:core && npm run verify:lipsync && npm run verify:diagrams && npm run build && npm run verify:secrets",
    "verify:lipsync": "node scripts/verify-lipsync.mjs",
    "verify:e2e": "node scripts/verify-e2e-lipsync.mjs",
    "verify:guardrails": "tsx scripts/verify-guardrails.ts",
    "verify:tools": "tsx scripts/verify-tools.ts",
    "verify:resilience": "tsx scripts/verify-resilience.ts",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:degradation": "node scripts/verify-degradation.mjs",
    "verify:reconnect": "node scripts/verify-reconnect.mjs",
    "verify:latency": "tsx scripts/verify-latency.ts",
    "verify:diagrams": "node scripts/verify-diagrams.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-direction": "^1.1.4",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.8",
    "livekit-server-sdk": "2.17.0",
    "lucide-react": "^1.31.0",
    "mammoth": "1.12.1",
    "next": "15.5.23",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "unpdf": "1.8.0",
    "zod": "3.25.76",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.5.4",
    "esbuild": "^0.25.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "postcss": "8.5.26",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.23.12",
