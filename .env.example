# ═══════════════════════════════════════════════════════════════════
#  دستیار دیجیتال فارسی — متغیرهای محیطی
#
#  ⚠️  هیچ‌کدام از این مقادیر نباید با پیشوند NEXT_PUBLIC_ تعریف شوند.
#  ⚠️  این فایل را در .env کپی کنید؛ فایل .env هرگز نباید commit شود.
#  ⚠️  در محیط عملیاتی از Secret Manager استفاده کنید، نه فایل .env
# ═══════════════════════════════════════════════════════════════════

# ── مدل زبانی ────────────────────────────────────────────────────
# gemini | groq | openai | anthropic | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
# فقط برای ollama یا سرویس‌های سازگار با OpenAI که میزبان دیگری دارند
LLM_BASE_URL=

# ── تعبیه‌سازی (Embedding) برای RAG ──────────────────────────────
# gemini | openai | ollama
#
# EMBEDDING_DIM باید با ابعاد ستون vector در prisma/schema.prisma
# (پیش‌فرض ۱۵۳۶) یکی باشد، وگرنه هنگام ایندکس خطای صریح می‌گیرید.
# مدل‌هایی که با ۱۵۳۶ سازگارند:
#   openai  → text-embedding-3-small  (دقیقاً ۱۵۳۶)
#   openai  → text-embedding-3-large  (با کاهش ابعاد به ۱۵۳۶)
#   gemini  → gemini-embedding-001    (خروجی قابل تنظیم روی ۱۵۳۶)
# برای هر ابعاد دیگری، ستون vector و مهاجرت را هم عوض کنید.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=1536

# ── پایگاه داده ──────────────────────────────────────────────────
DATABASE_URL=postgresql://digitalhuman:digitalhuman@localhost:5432/digitalhuman?schema=public

# ── تبدیل متن به صدا ─────────────────────────────────────────────
# elevenlabs | media-engine | none
TTS_PROVIDER=none
TTS_API_KEY=
TTS_MODEL=eleven_turbo_v2_5
# پس از ساخت Voice Clone به‌صورت خودکار در پایگاه داده ذخیره می‌شود؛
# این مقدار فقط برای صدای پیش‌فرض پیش از Clone است.
TTS_VOICE_ID=

# ── تبدیل صدا به متن ─────────────────────────────────────────────
# browser | media-engine | none
#   browser      = تشخیص گفتار مرورگر (بدون زیرساخت، فقط کروم/اج)
#   media-engine = Whisper روی سرویس GPU
STT_PROVIDER=browser
STT_MODEL=large-v3

# ── آواتار ───────────────────────────────────────────────────────
# media-engine | none
#   none = تصویر ثابت آواتار نمایش داده می‌شود (تنزل تدریجی طبق §۱۲)
AVATAR_PROVIDER=none
MEDIA_ENGINE_URL=http://localhost:8001
MEDIA_ENGINE_TOKEN=

# ── رسانهٔ بلادرنگ ───────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── اتوماسیون کسب‌وکار ───────────────────────────────────────────
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# ── احراز هویت ───────────────────────────────────────────────────
# با دستور: openssl rand -base64 32
AUTH_SECRET=
ADMIN_EMAIL=admin@example.com
# فقط برای seed اولیه استفاده می‌شود؛ پس از اولین ورود تغییرش دهید.
ADMIN_PASSWORD=

# ── تنظیمات عمومی ────────────────────────────────────────────────
KIOSK_RESET_SECONDS=120
DATA_RETENTION_DAYS=90
# محل ذخیرهٔ فایل‌های آپلودی (عکس، صدا، اسناد)
STORAGE_DIR=./storage
